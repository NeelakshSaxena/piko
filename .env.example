# Copy to .env only after reviewing docs/LOCAL_ONLY_POLICY.md.
# Never put production secrets in this file or commit .env. Lines starting with "# PIKO_" show an
# optional setting at its default; remove the "#" to change it.

# ---- Where it runs -------------------------------------------------------------------------
PIKO_ENV=development
PIKO_BIND_HOST=127.0.0.1
PIKO_PORT=8000
# Binding to anything but loopback is refused unless this is true AND PIKO_PUBLIC_BASE_URL is https
# (TLS ends at your reverse proxy). See docs/SELF_HOSTING.md.
# PIKO_ALLOW_PUBLIC_BIND=false
PIKO_LOG_LEVEL=INFO
PIKO_PUBLIC_BASE_URL=http://127.0.0.1:8000
PIKO_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
# Host header allowlist (the host of PIKO_PUBLIC_BASE_URL is always added).
PIKO_ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]"]

# ---- Database (PostgreSQL only) --------------------------------------------------------------
# Percent-encode special characters in the password (e.g. @ -> %40).
# Use a TLS connection (sslmode=require) for any remote database.
PIKO_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PIKO_DB_SCHEMA=piko

# ---- Secrets live in files, not here ---------------------------------------------------------
# Generate with: python -m app.cli generate-keys  (writes into .data/keys, never committed)
PIKO_JWT_PRIVATE_KEY_FILE=.data/keys/jwt_private.pem
PIKO_HMAC_KEY_FILE=.data/keys/hmac.key
# PIKO_JWT_ISSUER=piko

# ---- Sessions and limits ---------------------------------------------------------------------
# PIKO_ACCESS_TTL_SECONDS=3600
# PIKO_REFRESH_TTL_SECONDS=604800
# PIKO_BCRYPT_ROUNDS=12
# PIKO_MAX_BODY_BYTES=524288
# PIKO_LOGIN_FAILURE_LIMIT=10
# PIKO_LOGIN_FAILURE_WINDOW_SECONDS=900
# PIKO_PAIRING_CODE_TTL_SECONDS=900
# PIKO_POLLING_INTERVAL_SECONDS=60
# PIKO_TELEMETRY_MAX_BATCH_EVENTS=500
# PIKO_TELEMETRY_FUTURE_SKEW_SECONDS=60

# ---- Push notifications (optional; unset means off) ------------------------------------------
# python -m app.cli generate-push-secrets writes the VAPID key and the scheduler token.
# PIKO_FCM_PROJECT_ID=
# PIKO_FCM_SERVICE_ACCOUNT_FILE=
# PIKO_VAPID_PRIVATE_KEY_FILE=
# PIKO_VAPID_PUBLIC_KEY=
# PIKO_VAPID_SUBJECT=mailto:operator@example.invalid
# PIKO_OUTBOX_RUN_TOKEN_FILE=
# PIKO_OUTBOX_MAX_ATTEMPTS=8
# PIKO_OUTBOX_BATCH_SIZE=25
# PIKO_OUTBOX_BACKOFF_BASE_SECONDS=10
# PIKO_OUTBOX_BACKOFF_CAP_SECONDS=3600
# PIKO_SOS_NOTIFICATION_TTL_SECONDS=86400
# PIKO_MESSAGE_NOTIFICATION_TTL_SECONDS=86400

# ---- Live flight / train data for Journeys (optional; "manual" = no provider is ever called) --
# Journeys work fully without these. Keys stay here (.env is git-ignored), are used only by the server,
# and are never sent to the Android app. Rotate a key at once if it ever appears in chat, logs or a commit.
# Flights: Aviationstack (free plan: 100 requests/month, NON-COMMERCIAL). Rail: RailRadar (free: 100/month).
PIKO_FLIGHT_DATA_PROVIDER=manual
# PIKO_AVIATIONSTACK_API_KEY=
PIKO_RAIL_DATA_PROVIDER=manual
# PIKO_RAILRADAR_API_KEY=
# PIKO_LIVE_DATA_TIMEOUT_SECONDS=8
# PIKO_LIVE_DATA_CACHE_SECONDS=300
# PIKO_LIVE_DATA_COOLDOWN_SECONDS=900

# ---- Volume caps and retention ---------------------------------------------------------------
# PIKO_SOS_MAX_UNRESOLVED_PER_DEVICE=50
# PIKO_MESSAGES_MAX_PER_DEVICE_PER_DAY=500
# PIKO_MESSAGE_RETENTION_DAYS=90
# PIKO_AUDIT_RETENTION_DAYS=365
# PIKO_OUTBOX_RETENTION_DAYS=30

# ---- Read-only MCP adapter (local stdio only; OFF unless you turn it on) ---------------------
# The credential is NOT set here: issue one with `python -m app.cli mcp-token` and give it to the
# launching program as PIKO_MCP_TOKEN in that program's own environment.
PIKO_MCP_ENABLED=false
# PIKO_MCP_MAX_CALLS_PER_MINUTE=30
# PIKO_MCP_CALL_TIMEOUT_SECONDS=10
# PIKO_MCP_MAX_TOKEN_TTL_HOURS=720
