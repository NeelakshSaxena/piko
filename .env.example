# Copy to .env only after reviewing docs/LOCAL_ONLY_POLICY.md.
# Never put production secrets in this file or commit .env.
PIKO_ENV=development
PIKO_BIND_HOST=127.0.0.1
PIKO_PORT=8000
PIKO_DATABASE_URL=sqlite+aiosqlite:///./.data/piko-dev.db
PIKO_LOG_LEVEL=INFO
PIKO_MCP_ENABLED=false
PIKO_MCP_TRANSPORT=stdio
PIKO_PUBLIC_BASE_URL=http://127.0.0.1:8000
PIKO_ALLOWED_ORIGINS=http://127.0.0.1:3000
PIKO_TELEMETRY_RETENTION_DAYS=30
PIKO_AUDIT_LOCATION_PAYLOADS=false
