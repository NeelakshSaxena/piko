# Copy to .env only after reviewing docs/LOCAL_ONLY_POLICY.md.
# Never put production secrets in this file or commit .env.
PIKO_ENV=development
PIKO_BIND_HOST=127.0.0.1
PIKO_PORT=8000
# PostgreSQL only. Percent-encode special characters in the password (e.g. @ -> %40).
# Use a TLS connection (sslmode=require) for any remote database.
PIKO_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PIKO_DB_SCHEMA=piko
# Generate with: python -m app.cli generate-keys  (writes into .data/keys, never committed)
PIKO_JWT_PRIVATE_KEY_FILE=.data/keys/jwt_private.pem
PIKO_HMAC_KEY_FILE=.data/keys/hmac.key
PIKO_LOG_LEVEL=INFO
PIKO_MCP_ENABLED=false
PIKO_MCP_TRANSPORT=stdio
PIKO_PUBLIC_BASE_URL=http://127.0.0.1:8000
PIKO_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
# Host header allowlist (the host of PIKO_PUBLIC_BASE_URL is always added). Telemetry retention is per family (families.retention_days).
PIKO_ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]"]
PIKO_AUDIT_LOCATION_PAYLOADS=false
